# Copy this file to .env and fill in your Flattrade / Noren credentials.
# This login is SHARED by every symbol instance (one session, one websocket).

FT_USER=
FT_PWD=
FT_TOTP_KEY=
FT_API_KEY=
FT_API_SECRET=
FT_RURL=

# Regenerated every trading day. Leave blank and use the dashboard's
# "Generate Access Token" button (or "Save & Apply" to paste one manually) —
# either writes the new value here automatically. No restart needed.
FT_ACCESS_TOKEN=

# Optional platform settings
APP_HOST=0.0.0.0
APP_PORT=8000

# Optional dashboard login (HTTP Basic Auth). Leave both blank to disable
# (e.g. for local dev or SSH-tunnel-only access). If exposing the
# dashboard via a public/static IP + firewall rule, set both.
DASHBOARD_USER=
DASHBOARD_PASSWORD=
