# Copy this file to .env and fill in your Flattrade / Noren credentials.
# This login is SHARED by every symbol instance (one session, one websocket).

FT_USER=
FT_PWD=
FT_TOTP_KEY=
FT_API_KEY=
FT_API_SECRET=
FT_RURL=

# Regenerated every trading day. Leave blank and use the dashboard's
# "Generate Access Token" button (or "Save & Apply" to paste one manually) —
# either writes the new value here automatically. No restart needed.
FT_ACCESS_TOKEN=

# Optional platform settings
APP_HOST=0.0.0.0
APP_PORT=8000

# Optional dashboard login. Leave both blank to disable (e.g. for local
# dev or SSH-tunnel-only access). If exposing the dashboard via a
# public/static IP + firewall rule, set both.
DASHBOARD_USER=
DASHBOARD_PASSWORD=

# Optional: adds real 2FA on top of the above (a 6-digit code from
# Google Authenticator / Authy / etc, checked once at login — not
# resent on every request). Leave blank to log in with just
# username/password. To set up: run `python -m utils.session_auth`
# from the project root, it prints a secret + setup instructions.
DASHBOARD_TOTP_SECRET=

# Signs login session cookies. Set this so sessions survive a process
# restart — if left blank, a random key is generated at startup instead
# (safe, but every restart then logs everyone out). Any long random
# string works, e.g. generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET_KEY=
